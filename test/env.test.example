# Тестовый бот — скопируй этот файл в .env.test и заполни значения
# cp test/env.test.example test/.env.test

# Токен тестового бота (обязательно)
BOT_TOKEN=

# Часовой пояс
DEFAULT_TZ=Europe/Moscow

# Быстрые кнопки By mood и «Ещё практики»: состав, порядок и feature toggle.
# Доступны: lazy,no_mat,healthy_back,relax,hard,long,strello4ka,five,day,self
QUICK_PRACTICE_FILTERS=lazy,no_mat,healthy_back,relax,strello4ka,five,day,self

# Локальная PostgreSQL
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=
POSTGRESQL_DBNAME=yogadaily_test

# Для локальной PostgreSQL без SSL
POSTGRES_SSLMODE=disable

# Подписки только для тестового бота. По умолчанию выключены.
# Заполняй эти поля в test/.env.test, не в production .env.
SUBSCRIPTION_TEST_ENABLED=false
# Необязательное ограничение на отдельные ID; пусто = все пользователи тестового бота.
SUBSCRIPTION_TEST_USERS=
SUBSCRIPTION_TEST_DATABASE=yogadaily_test
# Только для ускоренного окончания оплаченной подписки одного тестировщика.
# Дата должна точно совпадать с subscription_ends в тестовой БД; продление отключает ускорение.
# SUBSCRIPTION_TEST_PAID_EXPIRY_USER=
# SUBSCRIPTION_TEST_PAID_EXPIRY_END=2026-10-15T17:00:00+03:00
# Для проверки пробного/бесплатного режима Mini App и ЮKassa не требуются.
# Без HTTPS-адреса кнопка открывает предпросмотр тарифов без оплаты.
SUBSCRIPTION_MINIAPP_URL=
# После настройки Main Mini App в BotFather: https://t.me/<test_bot>?startapp=payment
SUBSCRIPTION_PAYMENT_RETURN_URL=
SUBSCRIPTION_YOOKASSA_TEST_SHOP_ID=
SUBSCRIPTION_YOOKASSA_TEST_SECRET_KEY=
# Реальный платёж только в изолированном тестовом боте. По умолчанию выключен.
# Перед переключением применить data/migrations/20261020_payment_scope.sql.
SUBSCRIPTION_PAYMENT_MODE=test
SUBSCRIPTION_YOOKASSA_LIVE_SHOP_ID=1495040
SUBSCRIPTION_YOOKASSA_LIVE_SECRET_KEY=
# Для согласованного прогона 350 ₽: 1495040:350; само поле ключа оплату не включает.
SUBSCRIPTION_LIVE_PAYMENT_CONFIRM=

# Для загрузки практик из CSV (скрипты add_practices / add_mood_practices)
# YOUTUBE_COOKIES_BROWSER=chrome

# ID группового чата для утренних итогов челленджа (необязательно для локального теста)
CHALLENGE_GROUP_CHAT_ID=

# Календарный поток челленджа (обе переменные обязательны, чтобы запускать челлендж)
# CHALLENGE_START_DATE=2026-07-07
# CHALLENGE_START_PRACTICE_ID=54
CHALLENGE_START_DATE=
CHALLENGE_START_PRACTICE_ID=
