# Тестовый бот — скопируй этот файл в .env.test и заполни значения
# cp test/env.test.example test/.env.test

# Токен тестового бота (обязательно)
BOT_TOKEN=

# Часовой пояс
DEFAULT_TZ=Europe/Moscow

# Локальная PostgreSQL
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=
POSTGRESQL_DBNAME=yogadaily_test

# Для локальной PostgreSQL без SSL
POSTGRES_SSLMODE=disable

# Для загрузки практик из CSV (скрипты add_practices / add_mood_practices)
# YOUTUBE_COOKIES_BROWSER=chrome

# ID группового чата для утренних итогов челленджа (необязательно для локального теста)
CHALLENGE_GROUP_CHAT_ID=
